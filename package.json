{
  "name": "lg-xmb",
  "version": "0.1.31",
  "private": true,
  "description": "A webOS web-app adaptation of OpenXMB's interface and wave shader",
  "license": "GPL-3.0-only",
  "scripts": {
    "preview": "node tools/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/input-labels-browser.cjs && node tools/browser-check.cjs && node tests/upper-items-browser.cjs && node tests/wave-retention-browser.cjs",
    "package": "node tools/package.mjs",
    "verify:package": "node tools/package.mjs --verify-only",
    "test:compat": "node tests/compat-layout-browser.cjs",
    "tools:download": "node tools/dev-tools.cjs",
    "test:music": "node tests/background-music-browser.cjs",
    "test:effects": "node tests/effects-browser.cjs",
    "test:menu": "node tests/menu-browser.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "playwright": "1.62.1"
  }
}
